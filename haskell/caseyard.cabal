cabal-version: 3.0
name: caseyard
version: 0.1.0.0
synopsis: Isolated CLI tests against a local Docker Engine
description: Run independently named CLI cases in disposable containers using a caller-built local image.
category: Testing
extra-source-files: README.md, e2e/CLISpec.md
build-type: Simple

common settings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends:
    base >=4.18 && <5,
    aeson >=2.1 && <2.3,
    async >=2.2 && <2.3,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.9,
    filepath >=1.4 && <1.6,
    http-client >=0.7.13 && <0.8,
    http-types >=0.12 && <0.13,
    network >=3.1 && <3.3,
    tar >=0.6 && <0.8,
    text >=2.0 && <2.2

library
  import: settings
  hs-source-dirs: src
  exposed-modules: Test.CLI.E2E
  other-modules: Test.CLI.E2E.Internal

test-suite native
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test, src
  main-is: Spec.hs
  other-modules: NativeSpec, Fixture, Test.CLI.E2E, Test.CLI.E2E.Internal
  build-tool-depends: hspec-discover:hspec-discover >=2.10 && <2.12
  build-depends: hspec >=2.10 && <2.12
  ghc-options: -threaded

test-suite docker-e2e
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: e2e, src
  main-is: Spec.hs
  other-modules: CLISpec, Test.CLI.E2E, Test.CLI.E2E.Internal
  build-tool-depends: hspec-discover:hspec-discover >=2.10 && <2.12
  build-depends: hspec >=2.10 && <2.12
  ghc-options: -threaded
  if !flag(docker-e2e)
    buildable: False

flag docker-e2e
  description: Enable explicit Docker acceptance tests
  default: False
  manual: True
