default:
    @just --list

ghc-version := "9.10.3"
cabal-version := "3.16.1.0"
cabal := "ghcup run --ghc " + ghc-version + " --cabal " + cabal-version + " -- cabal"

# Install the pinned tools without changing the user's global selections.
setup:
    ghcup run --install --ghc {{ghc-version}} --cabal {{cabal-version}} -- cabal update

# Use the root Nix shell before these recipes.
check: generate
    {{cabal}} build -fdocker-e2e lib:caseyard test:native test:docker-e2e
    # No release maintainer is declared.
    {{cabal}} check --ignore=no-maintainer

build: generate
    {{cabal}} build lib:caseyard

test: generate
    {{cabal}} test native

# The caller must build e2e-example:local before this explicit task.
e2e: generate
    {{cabal}} test -fdocker-e2e docker-e2e

ci: check build test

# Keep the checked-in Cabal manifest usable without hpack in consumer projects.
generate:
    hpack hpack.yaml
