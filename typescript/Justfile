set shell := ["bash", "-euo", "pipefail", "-c"]

install:
    pnpm install --frozen-lockfile
fix: install
    pnpm exec vp run fix
check: install
    pnpm exec vp run check
build: install
    pnpm exec vp run build
test: install build
    pnpm exec vp run test
e2e: install
    pnpm exec vp run e2e
ci: check build test
