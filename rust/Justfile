set working-directory := "."

default:
    @just --list

fix:
    cargo fmt --all

check:
    cargo fmt --all -- --check
    cargo clippy --locked --all-targets -- -D warnings

build:
    cargo build --locked

test:
    cargo test --locked

ci: check build test

# Root builds e2e-example:local. This recipe never builds or pulls an image.
e2e:
    cargo test --locked --test e2e -- --ignored --nocapture
