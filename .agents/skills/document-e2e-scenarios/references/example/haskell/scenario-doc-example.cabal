cabal-version: 3.0
name: scenario-doc-example
version: 0.1.0.0
build-type: Simple

test-suite scenarios
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: MultipleScenariosSpec
  build-tool-depends: hspec-discover:hspec-discover >=2.10 && <2.12
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Werror -threaded
  build-depends:
    base >=4.18 && <5,
    cli-e2e,
    hspec >=2.10 && <2.12
