set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

fix:
    golangci-lint fmt
    golangci-lint run --fix ./...

check:
    golangci-lint fmt --diff
    golangci-lint run ./...

build:
    go build -o ./tmp/build/e2e-example .

# Compile Docker scenarios without executing them.
test:
    go test -race -run '^$' ./...

ci: check build test

image:
	docker build --tag e2e-example:local .

# Root task graph builds the image through the separate image task.
e2e-test:
	go test -race -v -shuffle=on -count=1 -parallel=2 -timeout=5m ./...
	image_id=$(docker image inspect e2e-example:local --format '{{{{.Id}}'); remaining=$(docker ps --all --filter "ancestor=$image_id" --format '{{{{.ID}}'); test -z "$remaining"

e2e: image e2e-test
