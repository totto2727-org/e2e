set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

fix:
    golangci-lint fmt
    golangci-lint run --build-tags=e2e --fix ./...

check:
    golangci-lint fmt --diff
    golangci-lint run --build-tags=e2e ./...
    go test -race -tags=e2e -run '^$' ./e2e

build:
    go build ./...

# Build caller-owned Linux executables without a C runtime dependency.
build-driver:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p target
    for arch in amd64 arm64; do
        CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -trimpath -ldflags='-s -w' -o "target/driver-linux-$arch" ./cmd/caseyard-driver
    done

test:
    go test -race ./...

# The caller prepares e2e-example:local before selecting Docker acceptance.
e2e:
    #!/usr/bin/env bash
    set -euo pipefail
    image_id=$(docker image inspect e2e-example:local --format '{{{{.Id}}')
    go test -race -tags=e2e -v -shuffle=on -count=1 -parallel=2 -timeout=5m ./e2e
    test "$image_id" = "$(docker image inspect e2e-example:local --format '{{{{.Id}}')"
    remaining=$(docker ps --all --filter "ancestor=$image_id" --format '{{{{.ID}}')
    test -z "$remaining"

ci: check build test
